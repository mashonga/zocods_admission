{
    "version": 2,
    "framework": null,
    "installCommand": "echo 'Skipping default install'",
    "buildCommand": "echo 'Skipping default build'",
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "/public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(css|js|images|build|svg|pdf|vendor|favicon\\.ico|robots\\.txt)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ],
    "env": {
        "APP_NAME": "ZOCODS Admissions",
        "APP_ENV": "production",
        "APP_DEBUG": "false",
        "APP_URL": "https://zocods.com",
        "LOG_CHANNEL": "stderr",
        "LOG_LEVEL": "error",
        "VIEW_COMPILED_PATH": "/tmp",
        "SESSION_DRIVER": "cookie",
        "SESSION_LIFETIME": "120",
        "CACHE_STORE": "array",
        "FILESYSTEM_DISK": "local",
        "QUEUE_CONNECTION": "sync",
        "PAYCHANGU_BASE_URL": "https://api.paychangu.com",
        "PAYCHANGU_CALLBACK_URL": "https://zocods.com/webhook/paychangu",
        "PAYCHANGU_RETURN_URL": "https://zocods.com/payment/return",
        "PAYCHANGU_TIMEOUT": "30",
        "PAYCHANGU_MODE": "live",
        "APPLICATION_FEE": "15000",
        "APPLICATION_CURRENCY": "MWK"
    }
}
